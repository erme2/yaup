#!/bin/sh
# Runs one apollo pass (skills/apollo/SKILL.md). Started by launchd every 15 minutes, at :02, :17, :32 and :47 (Efesto runs at :00, Dioniso at :30).
# A run is skipped while an earlier run still holds the lock. Set APOLLO_DRY_RUN=1 to
# report what would be merged or fixed without changing anything.

set -u

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
LOCK="$ROOT/.apollo.lock"
LOG="$ROOT/logs/apollo.log"
CLAUDE="${CLAUDE_BIN:-$HOME/.local/bin/claude}"

mkdir -p "$ROOT/logs"

stamp() { date '+%Y-%m-%d %H:%M:%S'; }

# Take the lock with mkdir, which is atomic. If it is held by a run that is gone, recover it under a
# second lock ($LOCK.recover), so that two invocations can't both clear it and both proceed.
# The pid is re-read under the recovery lock, so a lock that a recovering run just re-took is left alone.
acquire_lock() {
    if mkdir "$LOCK" 2>/dev/null; then
        echo "$$" > "$LOCK/pid"
        return 0
    fi
    # Recovery takes milliseconds. A recovery lock older than 10 minutes was left by a run that was killed
    # while holding it, so clear it; rmdir only removes an empty directory.
    if [ -d "$LOCK.recover" ] && [ -n "$(find "$LOCK.recover" -maxdepth 0 -mmin +10 2>/dev/null)" ]; then
        rmdir "$LOCK.recover" 2>/dev/null || true
    fi
    mkdir "$LOCK.recover" 2>/dev/null || return 1
    pid="$(cat "$LOCK/pid" 2>/dev/null || echo "")"
    status=1
    # An empty pid means a run is still writing it, so treat the lock as held rather than stale.
    if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then
        rm -rf "$LOCK"
        if mkdir "$LOCK" 2>/dev/null; then
            echo "$$" > "$LOCK/pid"
            status=0
        fi
    fi
    rmdir "$LOCK.recover"
    return $status
}

if ! acquire_lock; then
    echo "$(stamp) skipped: previous run still running" >> "$LOG"
    exit 0
fi

# Efesto and Dioniso switch branches in repos/ too: hold their shared checkout lock while this pass runs.
# Remove the shared lock only if this run created it, so a skipped run never deletes another agent's lock.
SHARED_LOCK="$HOME/.yaup/checkouts.lock"
SHARED_OWNED=0
trap 'rm -rf "$LOCK"; if [ "$SHARED_OWNED" = 1 ]; then rm -rf "$SHARED_LOCK"; fi' EXIT INT TERM
mkdir -p "$HOME/.yaup"
if ! mkdir "$SHARED_LOCK" 2>/dev/null; then
    echo "$(stamp) skipped: a board agent is using the checkouts" >> "$LOG"
    exit 0
fi
SHARED_OWNED=1

if [ "${APOLLO_DRY_RUN:-0}" = "1" ]; then
    mode="DRY RUN: report only, change nothing."
else
    mode="LIVE: merge and fix as the skill allows."
fi

echo "$(stamp) run started ($mode)" >> "$LOG"

cd "$ROOT" || exit 1
"$CLAUDE" -p "Run one apollo pass. Follow skills/apollo/SKILL.md and docs/agent-workflow-autonomy.md. $mode Write the run summary to logs/apollo.log." \
    --allowedTools "Read" "Edit" "Write" "Grep" "Glob" \
        "Bash(gh:*)" "Bash(git:*)" "Bash(php:*)" "Bash(composer:*)" "Bash(npm:*)" "Bash(npx:*)" "Bash(node:*)" \
        "Bash(date:*)" "Bash(ls:*)" "Bash(cat:*)" "Bash(tail:*)" \
        "mcp__claude_ai_Slack__slack_send_message" \
    >> "$LOG" 2>&1
status=$?

echo "$(stamp) run finished (exit $status)" >> "$LOG"
exit "$status"
