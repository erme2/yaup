<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.yaup.ermes</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/.ermes/run.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Minute</key>
    <integer>50</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/.ermes/logs/launchd.out</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.ermes/logs/launchd.err</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
